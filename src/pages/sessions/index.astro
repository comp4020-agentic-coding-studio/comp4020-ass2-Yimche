---
import ContentLayout from "astro-theme-university/layouts/ContentLayout.astro";
import SessionsGrid from "../../components/SessionsGrid.astro";
import { sessionLabels, siteConfig } from "../../site-config";
---

<ContentLayout
  title={sessionLabels.plural}
  {...siteConfig}
>
  <p>
    The labs are where the course actually happens. Every week has one: come
    with the week's work in progress, build and break things alongside everyone
    else, and leave with something running. Each lab page lists what to bring,
    what we do on the day, and what you walk out with.
  </p>
  <SessionsGrid />
</ContentLayout>
